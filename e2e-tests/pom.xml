<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.irurueta.authserver</groupId>
    <artifactId>irurueta-auth-server-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>e2e-tests</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <description>End-to-end browser tests: the packaged auth-server and bff applications driven through headless Chromium.</description>

  <dependencies>
    <!-- shared test harness: PostgreSQL Testcontainers support and the JUnit test stack -->
    <dependency>
      <groupId>com.irurueta.authserver</groupId>
      <artifactId>test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      The packaged applications under test. They are declared only so the reactor builds (and packages) them before
      this module; the tests launch their jars in child JVMs, so transitive dependencies are excluded and the fat
      jars contribute nothing but their loader classes to this module's classpath.
    -->
    <dependency>
      <groupId>com.irurueta.authserver</groupId>
      <artifactId>auth-server-boot</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.irurueta.authserver</groupId>
      <artifactId>bff-boot</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--
      Playwright for Java was chosen over Selenium because it manages its own browser binaries, auto-waits for
      elements (no explicit waits or flaky sleeps), and drives headless Chromium out of the box in CI.
      Playwright.create() downloads the matching Chromium build on first use (cached afterwards), so no separate
      install step is needed locally or in CI.
    -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <authserver.jar>${project.basedir}/../auth-server/boot/target/auth-server-boot-${project.version}.jar</authserver.jar>
            <bff.jar>${project.basedir}/../bff/boot/target/bff-boot-${project.version}.jar</bff.jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
