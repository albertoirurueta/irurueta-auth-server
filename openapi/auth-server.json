{
  "components" : {
    "schemas" : {
      "ChangePasswordRequest" : {
        "description" : "Change of the password of the authenticated account",
        "properties" : {
          "currentPassword" : {
            "description" : "Password in use",
            "format" : "password",
            "minLength" : 1,
            "type" : "string"
          },
          "newPassword" : {
            "description" : "Password to set",
            "format" : "password",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [
          "currentPassword",
          "newPassword"
        ],
        "type" : "object"
      },
      "ClientRequest" : {
        "description" : "Definition of a registered client; it never contains a secret",
        "properties" : {
          "accessTokenFormat" : {
            "type" : "string"
          },
          "accessTokenTtl" : {
            "format" : "duration",
            "type" : "string"
          },
          "audiences" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "authMethods" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "clientId" : {
            "minLength" : 1,
            "type" : "string"
          },
          "confidential" : {
            "type" : "boolean"
          },
          "grantTypes" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "name" : {
            "minLength" : 1,
            "type" : "string"
          },
          "redirectUris" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "refreshTokenTtl" : {
            "format" : "duration",
            "type" : "string"
          },
          "requireProofKey" : {
            "type" : "boolean"
          },
          "reuseRefreshTokens" : {
            "type" : "boolean"
          },
          "scopes" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [
          "accessTokenTtl",
          "authMethods",
          "clientId",
          "grantTypes",
          "name",
          "redirectUris",
          "refreshTokenTtl",
          "scopes"
        ],
        "type" : "object"
      },
      "ClientResponse" : {
        "description" : "A registered client, without any secret",
        "properties" : {
          "accessTokenFormat" : {
            "type" : "string"
          },
          "accessTokenTtl" : {
            "format" : "duration",
            "type" : "string"
          },
          "audiences" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "authMethods" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "clientId" : {
            "type" : "string"
          },
          "confidential" : {
            "type" : "boolean"
          },
          "grantTypes" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "name" : {
            "type" : "string"
          },
          "redirectUris" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "refreshTokenTtl" : {
            "format" : "duration",
            "type" : "string"
          },
          "requireProofKey" : {
            "type" : "boolean"
          },
          "reuseRefreshTokens" : {
            "type" : "boolean"
          },
          "scopes" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "ClientSecretResponse" : {
        "description" : "The new client secret; it is shown only once",
        "properties" : {
          "clientSecret" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "CreatedClientResponse" : {
        "description" : "The created client; the secret is shown only once",
        "properties" : {
          "client" : {
            "$ref" : "#/components/schemas/ClientResponse"
          },
          "clientSecret" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PasswordResetRequest" : {
        "description" : "Request of a password reset link",
        "properties" : {
          "email" : {
            "description" : "E-mail address of the account",
            "format" : "email",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [
          "email"
        ],
        "type" : "object"
      },
      "RegisterRequest" : {
        "description" : "Registration of a new account",
        "properties" : {
          "email" : {
            "description" : "E-mail address that receives the verification link",
            "format" : "email",
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "description" : "Chosen password",
            "format" : "password",
            "minLength" : 1,
            "type" : "string"
          },
          "username" : {
            "description" : "Desired username",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [
          "email",
          "password",
          "username"
        ],
        "type" : "object"
      },
      "ResetPasswordRequest" : {
        "description" : "Reset of a forgotten password with the token received by e-mail",
        "properties" : {
          "newPassword" : {
            "description" : "Password to set",
            "format" : "password",
            "minLength" : 1,
            "type" : "string"
          },
          "token" : {
            "description" : "Reset token received by e-mail",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [
          "newPassword",
          "token"
        ],
        "type" : "object"
      },
      "SigningKeyResponse" : {
        "description" : "A signing key, without its private half",
        "properties" : {
          "activatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "alg" : {
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "kid" : {
            "type" : "string"
          },
          "publicJwk" : {
            "type" : "string"
          },
          "retiredAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "REST endpoints of the example OAuth 2.1 / OpenID Connect authorization server.",
    "license" : {
      "name" : "Apache License 2.0",
      "url" : "https://www.apache.org/licenses/LICENSE-2.0.txt"
    },
    "title" : "Irurueta Auth Server API",
    "version" : "1.0.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/account/password" : {
      "post" : {
        "description" : "Requires a bearer token issued by this server.",
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Password changed"
          },
          "400" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Wrong current password or rejected new password"
          },
          "401" : {
            "description" : "Missing or invalid bearer token"
          }
        },
        "summary" : "Changes the password of the authenticated account",
        "tags" : [
          "Account"
        ]
      }
    },
    "/api/account/password/reset" : {
      "post" : {
        "description" : "A rejected password does not use up the token. Rate limited per client address.",
        "operationId" : "resetPassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Password reset"
          },
          "400" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Invalid token or rejected password"
          },
          "429" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Too many requests from this client or for this address"
          }
        },
        "summary" : "Resets a forgotten password",
        "tags" : [
          "Account"
        ]
      }
    },
    "/api/account/password/reset-request" : {
      "post" : {
        "description" : "The answer is the same whether or not the e-mail address belongs to an account; only a registered address receives a message. Rate limited per client address and per e-mail address.",
        "operationId" : "requestPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Request accepted; a registered address is sent a link"
          },
          "400" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Invalid request"
          },
          "429" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Too many requests from this client or for this address"
          }
        },
        "summary" : "Requests a password reset link",
        "tags" : [
          "Account"
        ]
      }
    },
    "/api/account/register" : {
      "post" : {
        "description" : "The answer is the same whether or not the e-mail address or the username is already taken. Rate limited per client address and per e-mail address.",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Registration accepted; an e-mail is sent"
          },
          "400" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Invalid request or rejected password"
          },
          "429" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Too many requests from this client or for this address"
          },
          "503" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "The e-mail could not be sent; nothing was registered"
          }
        },
        "summary" : "Registers an account",
        "tags" : [
          "Account"
        ]
      }
    },
    "/api/account/verify" : {
      "get" : {
        "description" : "A verification link works once. Rate limited per client address.",
        "operationId" : "verify",
        "parameters" : [
          {
            "in" : "query",
            "name" : "token",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "204" : {
            "description" : "E-mail address verified"
          },
          "400" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "The token is invalid, expired or already used"
          },
          "429" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Too many requests from this client or for this address"
          }
        },
        "summary" : "Verifies an e-mail address",
        "tags" : [
          "Account"
        ]
      }
    },
    "/api/admin/clients" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/ClientResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "The clients"
          }
        },
        "summary" : "Lists the registered clients",
        "tags" : [
          "Clients"
        ]
      },
      "post" : {
        "description" : "The generated secret of a confidential client is returned only in this answer.",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ClientRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CreatedClientResponse"
                }
              }
            },
            "description" : "The created client"
          },
          "400" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Invalid definition"
          },
          "409" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "The client identifier is already registered"
          }
        },
        "summary" : "Creates a client",
        "tags" : [
          "Clients"
        ]
      }
    },
    "/api/admin/clients/{clientId}" : {
      "delete" : {
        "operationId" : "delete",
        "parameters" : [
          {
            "in" : "path",
            "name" : "clientId",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "204" : {
            "description" : "Client deleted"
          },
          "404" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "No such client"
          }
        },
        "summary" : "Deletes a client",
        "tags" : [
          "Clients"
        ]
      },
      "get" : {
        "operationId" : "get",
        "parameters" : [
          {
            "in" : "path",
            "name" : "clientId",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClientResponse"
                }
              }
            },
            "description" : "The client"
          },
          "404" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "No such client"
          }
        },
        "summary" : "Gets a registered client",
        "tags" : [
          "Clients"
        ]
      },
      "put" : {
        "description" : "The secret of the client is not changed.",
        "operationId" : "update",
        "parameters" : [
          {
            "in" : "path",
            "name" : "clientId",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ClientRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClientResponse"
                }
              }
            },
            "description" : "The updated client"
          },
          "400" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "Invalid definition"
          },
          "404" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "No such client"
          }
        },
        "summary" : "Updates a client",
        "tags" : [
          "Clients"
        ]
      }
    },
    "/api/admin/clients/{clientId}/secret" : {
      "post" : {
        "description" : "The new secret is returned only in this answer.",
        "operationId" : "rotateSecret",
        "parameters" : [
          {
            "in" : "path",
            "name" : "clientId",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClientSecretResponse"
                }
              }
            },
            "description" : "The new secret"
          },
          "400" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "The client is public"
          },
          "404" : {
            "content" : {
              "application/problem+json" : { }
            },
            "description" : "No such client"
          }
        },
        "summary" : "Rotates the secret of a confidential client",
        "tags" : [
          "Clients"
        ]
      }
    },
    "/api/admin/keys" : {
      "get" : {
        "description" : "Never exposes private key material.",
        "operationId" : "list_1",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/SigningKeyResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "The keys"
          }
        },
        "summary" : "Lists the signing keys",
        "tags" : [
          "Signing keys"
        ]
      }
    },
    "/api/admin/keys/rotate" : {
      "post" : {
        "description" : "Forces a rotation whatever the age of the active key: the active key is retired (it stays published until the tokens it signed expire), the next key becomes active and a new next key is generated. Keys retired for longer than the retention are deleted, and the published keys are refreshed. The scheduled rotation, in contrast, only rotates a key that is due.",
        "operationId" : "rotate",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/SigningKeyResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "The keys after the rotation"
          }
        },
        "summary" : "Rotates the signing keys now",
        "tags" : [
          "Signing keys"
        ]
      }
    }
  },
  "tags" : [
    {
      "description" : "Self-service account management",
      "name" : "Account"
    },
    {
      "description" : "Administration of the signing keys",
      "name" : "Signing keys"
    },
    {
      "description" : "Administration of the registered clients",
      "name" : "Clients"
    }
  ]
}
