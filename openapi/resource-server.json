{
  "components" : {
    "schemas" : {
      "DocumentResponse" : {
        "description" : "A document owned by a user.",
        "properties" : {
          "content" : {
            "description" : "Body of the document.",
            "type" : "string"
          },
          "id" : {
            "description" : "Unique identifier of the document.",
            "type" : "string"
          },
          "owner" : {
            "description" : "Subject of the user who owns the document.",
            "type" : "string"
          },
          "title" : {
            "description" : "Short title of the document.",
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Protected REST API of the example resource server.",
    "license" : {
      "name" : "Apache License 2.0",
      "url" : "https://www.apache.org/licenses/LICENSE-2.0.txt"
    },
    "title" : "Irurueta Resource Server API",
    "version" : "1.0.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/documents" : {
      "get" : {
        "description" : "Lists the caller's documents; an administrator sees all. Needs scope documents.read.",
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/DocumentResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "The documents."
          },
          "401" : {
            "description" : "Missing or invalid bearer token."
          },
          "403" : {
            "description" : "The token lacks the documents.read scope."
          }
        },
        "security" : [
          {
            "bearer" : [ ]
          }
        ],
        "summary" : "Lists documents",
        "tags" : [
          "documents"
        ]
      }
    },
    "/api/documents/{id}" : {
      "delete" : {
        "description" : "Deletes one of the caller's documents; an administrator may delete any. Needs scope documents.delete. Someone else's document is answered 404, like a missing one.",
        "operationId" : "delete",
        "parameters" : [
          {
            "in" : "path",
            "name" : "id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "204" : {
            "description" : "The document was deleted."
          },
          "401" : {
            "description" : "Missing or invalid bearer token."
          },
          "403" : {
            "description" : "The token lacks the documents.delete scope."
          },
          "404" : {
            "description" : "The document does not exist or belongs to someone else."
          }
        },
        "security" : [
          {
            "bearer" : [ ]
          }
        ],
        "summary" : "Deletes a document",
        "tags" : [
          "documents"
        ]
      }
    },
    "/test/protected" : {
      "get" : {
        "operationId" : "subject",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "protected-test-controller"
        ]
      }
    }
  },
  "tags" : [
    {
      "description" : "Documents of the authenticated user.",
      "name" : "documents"
    }
  ]
}
