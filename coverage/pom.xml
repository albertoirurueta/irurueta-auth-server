      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>auth-server-infrastructure-keys</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>auth-server-infrastructure-mail</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>auth-server-infrastructure-sms</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>auth-server-infrastructure-github</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>auth-server-api-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>auth-server-boot</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>bff-domain</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>bff-application</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>bff-infrastructure-session</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>bff-infrastructure-resourceserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>bff-api-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>bff-boot</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>resource-server-domain</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>resource-server-application</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>resource-server-infrastructure-memory</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>resource-server-api-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>resource-server-boot</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>service-client-boot</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- jacoco:check's own goal only ever analyzes the CURRENT project's own
           ${project.build.outputDirectory} against a single ${dataFile} (see org.jacoco.maven.CheckMojo) -
           it has no multi-module awareness of its own, unlike report-aggregate. Since this module has no
           source of its own, both the classes and the merged execution data it must check against are
           materialized here explicitly: maven-dependency-plugin unpacks every sibling module's own compiled
           classes (this project's own groupId only, non-transitively, so third-party classes never leak in)
           into this module's target/classes, and jacoco:merge combines every sibling module's *.exec into one
           file - both bound well before jacoco-check's own `verify` execution below. This is what makes the
           BUNDLE that jacoco-check evaluates the genuine reactor-wide aggregate instead of an empty one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-module-classes</id>
            <!-- Must NOT run before `package`: unpack-dependencies on a reactor artifact fails with
                 "Artifact has not been packaged yet" (MDEP-98), which broke plain `mvn test` outright even
                 though nothing needs these classes until `verify`. Binding here keeps `mvn test` working (the
                 coverage module's lifecycle simply stops before this phase) while still running ahead of
                 jacoco's report-aggregate and check executions below, both bound to `verify`. -->
            <phase>package</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeGroupIds>${project.groupId}</includeGroupIds>
              <!-- the applications are handled by their own execution below: their artifact is
                   spring-boot:repackage's executable jar, so a plain unpack would drag in every third-party
                   dependency nested under BOOT-INF/lib, some of which collide by class name. -->
              <excludeArtifactIds>auth-server-boot,bff-boot,resource-server-boot,service-client-boot</excludeArtifactIds>
              <excludeTransitive>true</excludeTransitive>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <!-- the applications' own classes, taken from BOOT-INF/classes inside the repackaged executable jar and
                 remapped back to the root of the output directory so they sit alongside the other modules'.
                 Execution data alone is NOT enough to put a class in a JaCoCo bundle - the report needs the
                 class file itself - so without this execution the entire application is silently absent from
                 the aggregate, and therefore from the gate below and from the SonarCloud coverage that
                 sonar.coverage.jacoco.xmlReportPaths reads. BOOT-INF/lib is deliberately not unpacked. -->
            <id>unpack-boot-classes</id>
            <phase>package</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeGroupIds>${project.groupId}</includeGroupIds>
              <includeArtifactIds>auth-server-boot,bff-boot,resource-server-boot,service-client-boot</includeArtifactIds>
              <includes>BOOT-INF/classes/**</includes>
              <excludeTransitive>true</excludeTransitive>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <fileMappers>
                <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                  <pattern>^BOOT-INF/classes/(.*)$</pattern>
                  <replacement>$1</replacement>
                </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
              </fileMappers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aggregate-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <configuration>
              <dataFileIncludes>
                <dataFileInclude>**/jacoco*.exec</dataFileInclude>
              </dataFileIncludes>
              <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
              <!-- report-aggregate only auto-discovers sibling modules declared as compile/runtime/provided
                   dependencies (org.jacoco.maven.ReportAggregateMojo#findDependencies) - every module here is
                   deliberately scope=test, so without this flag the aggregate silently analyzes zero classes
                   (an empty, always-passing report) no matter how well-tested the reactor actually is.
                   includeCurrentProject makes it also analyze this project's own output directory, which the
                   maven-dependency-plugin execution above populates with every sibling module's real classes. -->
              <includeCurrentProject>true</includeCurrentProject>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-merge</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${maven.multiModuleProjectDirectory}</directory>
                  <includes>
                    <include>**/target/jacoco*.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
