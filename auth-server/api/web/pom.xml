<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.irurueta.authserver</groupId>
    <artifactId>irurueta-auth-server-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>auth-server-api-web</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <description>Web adapter of the authorization server: security filter chains, the login, consent and logout pages and their extension points, the REST API, OpenAPI description.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>auth-server-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>auth-server-application</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <!-- bearer-token validation of the /api/** chain -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <!-- sign in with an external provider (oauth2Login): Google, Microsoft Entra ID, Apple and GitHub; also brings the
           Jackson mixins of the client types that the stored principal of such a sign-in needs -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <!-- passkeys (WebAuthn): WebAuthnConfigurer support, filters and the WebAuthn4J based operations; brings
           webauthn4j-core transitively at the version Spring Security 7.1 was built against -->
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-webauthn</artifactId>
    </dependency>
    <dependency>
      <!-- Argon2 implementation used by Spring Security's Argon2PasswordEncoder -->
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- generates the client certificates of the X.509 tests at run time, so none is kept in the repository -->
      <groupId>${project.groupId}</groupId>
      <artifactId>test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- contract-first REST API and HTML pages: interfaces and DTOs generated from apis/auth-server/rest-server and
           apis/auth-server/web-pages (see apis/README.md);
           the shared generator options live in the root pom's pluginManagement -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-rest-server-v1</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${maven.multiModuleProjectDirectory}/apis/auth-server/rest-server/auth-server-api-v1.yaml</inputSpec>
              <apiPackage>com.irurueta.authserver.authorization.api.web.v1.generated.api</apiPackage>
              <modelPackage>com.irurueta.authserver.authorization.api.web.v1.generated.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <!-- standalone HTML reference of the contract, published by the Documentation workflow -->
            <id>generate-rest-server-docs</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${maven.multiModuleProjectDirectory}/apis/auth-server/rest-server/auth-server-api-v1.yaml</inputSpec>
              <generatorName>html2</generatorName>
              <output>${project.build.directory}/generated-docs/rest-server/v1</output>
              <addCompileSourceRoot>false</addCompileSourceRoot>
              <!-- the page itself is a supporting file of the html2 generator -->
              <generateSupportingFiles>true</generateSupportingFiles>
            </configuration>
          </execution>
          <execution>
            <!-- contract-first HTML pages: the interfaces of the page controllers (login, consent, logout), generated
                 from apis/auth-server/web-pages; each answers text/html rendered by PageRenderer -->
            <id>generate-web-pages-v1</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${maven.multiModuleProjectDirectory}/apis/auth-server/web-pages/auth-server-pages-v1.yaml</inputSpec>
              <apiPackage>com.irurueta.authserver.authorization.api.web.pages.v1.generated.api</apiPackage>
              <modelPackage>com.irurueta.authserver.authorization.api.web.pages.v1.generated.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <!-- standalone HTML reference of the pages contract, published by the Documentation workflow -->
            <id>generate-web-pages-docs</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${maven.multiModuleProjectDirectory}/apis/auth-server/web-pages/auth-server-pages-v1.yaml</inputSpec>
              <generatorName>html2</generatorName>
              <output>${project.build.directory}/generated-docs/web-pages/v1</output>
              <addCompileSourceRoot>false</addCompileSourceRoot>
              <!-- the page itself is a supporting file of the html2 generator -->
              <generateSupportingFiles>true</generateSupportingFiles>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-api-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>com.irurueta.authserver:auth-server-infrastructure-*</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-jdbc</exclude>
                    <exclude>org.springframework:spring-jdbc</exclude>
                  </excludes>
                  <message>An api module must not depend on an infrastructure module, nor reach a data store
                    directly.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
