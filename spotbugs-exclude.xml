<!--
  SpotBugs runs at threshold=Medium, effort=Max. Every exclusion here needs a comment saying why; a false
  positive at a named site is recorded as a narrow Match (class + method + bug pattern), never a relaxed threshold.
-->
<FindBugsFilter>
  <!-- Spring Boot main application classes: nothing to analyse beyond the generated main method, and they are
       excluded from coverage for the same reason. -->
  <Match>
    <Class name="~.*Application"/>
  </Match>
  <!-- Code generated by openapi-generator from the contracts under apis/ into target/generated-sources (packages
       named *.generated.*): the server interfaces and DTO records, and the REST client of another service. They are
       never committed nor hand-edited, so a finding there cannot be fixed in this repository; the fix belongs in the
       contract or the generator configuration. Checkstyle, PMD/CPD and JaCoCo leave them out the same way. -->
  <Match>
    <Package name="~.*\.generated(\..*)?"/>
  </Match>
  <!-- The request to verify a second factor carries, by reference, the Authentication the user already holds: the
       provider builds the answer from that very object (Spring Security's own tokens hold their principal the same
       way) and a defensive copy of an Authentication does not exist. -->
  <Match>
    <Class name="com.irurueta.authserver.authorization.api.web.totp.TotpAuthenticationToken"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Same as TotpAuthenticationToken: the request to verify a one-time code as a second factor carries, by reference,
       the Authentication the user already holds. It is an immutable Spring Security object that the provider hands
       back enriched, so no copy could be made, and it is never shared outside the request. -->
  <Match>
    <Class name="com.irurueta.authserver.authorization.api.web.ott.OttSecondFactorToken"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- OAuth2TokenClaimsSet.Builder.claims(Consumer) and JwtClaimsSet.Builder.claims(Consumer) mutate the builder through
       the consumer, which is the whole purpose of the call, so ignoring the builder they return is correct (a false
       positive). The detector infers "no side effect" for a library method from the classes the analysis loads, and the
       inference flipped for these two customizers as soon as the one-time token login configurer of Spring Security was
       referenced by OttChainCustomizer, without any change to them. -->
  <Match>
    <Class name="com.irurueta.authserver.authorization.api.web.tokens.ReferenceTokenClaimsCustomizer"/>
    <Method name="customize"/>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
  </Match>
  <Match>
    <Class name="com.irurueta.authserver.authorization.api.web.tokens.RolesTenantAudienceTokenCustomizer"/>
    <Method name="customize"/>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
  </Match>
  <!-- The filter keeps the Spring-managed cookie writer it is built with; the filter is created by a configuration
       and never exposed, so the reference cannot be used to alter it from outside. -->
  <Match>
    <Class name="com.irurueta.authserver.authorization.api.web.totp.TotpAuthenticationFilter"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
