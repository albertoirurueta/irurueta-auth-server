<!--
  SpotBugs runs at threshold=Medium, effort=Max. Every exclusion here needs a comment saying why; a false
  positive at a named site is recorded as a narrow Match (class + method + bug pattern), never a relaxed threshold.
-->
<FindBugsFilter>
  <!-- Spring Boot main application classes: nothing to analyse beyond the generated main method, and they are
       excluded from coverage for the same reason. -->
  <Match>
    <Class name="~.*Application"/>
  </Match>
  <!-- Interfaces and DTO records generated by openapi-generator from the contracts under apis/ into
       target/generated-sources (packages named *.generated.*). They are never committed nor hand-edited, so a
       finding there cannot be fixed in this repository; the fix belongs in the contract or the generator
       configuration. Checkstyle, PMD/CPD and JaCoCo leave them out the same way. -->
  <Match>
    <Package name="~.*\.generated(\..*)?"/>
  </Match>
</FindBugsFilter>
