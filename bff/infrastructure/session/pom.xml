<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.irurueta.authserver</groupId>
    <artifactId>irurueta-auth-server-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>bff-infrastructure-session</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <description>Session persistence adapter of the BFF: the HTTP session (and with it the OAuth2 tokens of the user) stored in PostgreSQL by Spring Session JDBC, its hardened cookie and the Flyway migration of its schema.</description>

  <dependencies>
    <!-- tag::setup-bff-session-starters[] -->
    <!-- HTTP session store: Spring Session JDBC (spring-session-jdbc comes in through the Boot starter, which also
         auto-configures it from the spring.session.* properties) on the bff database -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-session-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- end::setup-bff-session-starters[] -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the servlet API and spring-web behind the mock request and response of the cookie serializer test; the
         application gets both from the web starter that bff-api-web brings into bff-boot -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-infrastructure-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>com.irurueta.authserver:bff-api-*</exclude>
                    <!-- wildcard, not today's siblings: an adapter added later is banned without editing this rule.
                         Maven never bans a module's own artifact, so matching this module's own id is safe. -->
                    <exclude>com.irurueta.authserver:bff-infrastructure-*</exclude>
                  </excludes>
                  <message>An infrastructure module must not depend on an api module or on a sibling
                    infrastructure module.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
